# Flight Service
FLIGHT_DATABASE_URL=postgresql://flight_user:flight_pass@flight-db:5432/flight_db
FLIGHT_REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26380,redis-sentinel-3:26381
FLIGHT_REDIS_MASTER_NAME=mymaster
FLIGHT_GRPC_PORT=50051
FLIGHT_API_KEY=flight-service-secret-key-12345

# Booking Service
BOOKING_DATABASE_URL=postgresql://booking_user:booking_pass@booking-db:5432/booking_db
BOOKING_FLIGHT_SERVICE_HOST=flight-service
BOOKING_FLIGHT_SERVICE_PORT=50051
BOOKING_FLIGHT_SERVICE_API_KEY=flight-service-secret-key-12345

# Retry Settings
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_WAIT=0.1
RETRY_MAX_WAIT=0.4

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
